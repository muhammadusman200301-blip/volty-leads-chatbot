{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "@voltade/sdk/globals"
    ],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/volty/entry.tsbuildinfo",
    "jsx": "react-jsx",
    "paths": {
      "~/project/*": [
        "./*"
      ],
      "~/*": [
        "./node_modules/@voltade/sdk/*"
      ]
    }
  },
  "include": [
    "pages/**/entry.tsx"
  ]
}
