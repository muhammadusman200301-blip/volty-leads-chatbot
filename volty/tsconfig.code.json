{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [],
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/volty/code.tsbuildinfo",
    "jsx": "react-jsx",
    "paths": {
      "~/project/*": [
        "./*"
      ],
      "~/*": [
        "./node_modules/@voltade/sdk/*"
      ]
    },
    "allowUnreachableCode": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "pages/**/entry.tsx"
  ]
}
